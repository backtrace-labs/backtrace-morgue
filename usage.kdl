// morgue CLI Usage Specification
// https://usage.jdx.dev/spec/

name "morgue"
bin "morgue"
about "Command-line interface to the Backtrace object store"
version "from-package-json"

// Global flags
flag "--endpoint" help="Specify API endpoint" global=#true {
    arg "<URL>"
}
flag "--token" help="Specify API token" global=#true {
    arg "<TOKEN>"
}
flag "--universe" help="Universe name" global=#true {
    arg "<UNIVERSE>"
}
flag "--project" help="Project name" global=#true {
    arg "<PROJECT>"
}
flag "--timeout" help="Set the timeout on API requests in milliseconds" global=#true {
    arg "<MS>"
}
flag "-h --help" help="Print help and exit" global=#true
flag "-v --version" help="Print version number and exit"
flag "--debug" help="Enable verbose debug printing" global=#true
flag "-k" help="Disable SSL verification with CA"  global=#true

// Commands

cmd "login" help="Log into a Backtrace server" {
    arg "<URL>" help="Server URL (e.g., http://localhost)"
}

cmd "logout" help="Log out from the current server"

cmd "clean" help="Apply sampling retroactively" {
    arg "<PROJECT>" help="Project name or universe/project"
    
    flag "--keep" help="Number of objects to keep per fingerprint" {
        arg "<N>"
    }
    flag "--oldest" help="Keep N oldest objects" {
        arg "<N>"
    }
    flag "--output" help="Output object IDs to stdout"
    flag "--verbose" help="Verbose output"
}

cmd "describe" help="List and describe queryable metadata" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<SUBSTRING>" help="Filter by substring" required=#false
}

cmd "get" help="Download object from object store" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<OBJECT_ID>" help="Object identifier"
    
    flag "-o --output" help="Output to file" {
        arg "<FILE>"
    }
    flag "--resource" help="Fetch specific resource" {
        arg "<NAME>"
    }
}

cmd "put" help="Upload object to object store" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<FILE>" help="File to upload"
    
    flag "--format" help="File format: btt|minidump|json|plcrash|symbols" required=#true {
        arg "<FORMAT>" {
            choices btt minidump json plcrash symbols
        }
    }
    flag "--compression" help="Compression: gzip|deflate" {
        arg "<TYPE>" {
            choices gzip deflate
        }
    }
    flag "--kv" help="Key-value pairs: key1:value1,key2:value2" {
        arg "<PAIRS>"
    }
    flag "--form_data" help="Upload using multipart/form-data"
}

cmd "set" help="Modify object attributes" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<QUERY>" help="Query or object ID"
    arg "<ASSIGNMENT>" help="key=value assignment"
    
    flag "--filter" help="Filter expression" {
        arg "<FILTER>"
    }
    flag "--age" help="Age filter" {
        arg "<TIME>"
    }
    flag "--time" help="Time filter" {
        arg "<RANGE>"
    }
}

cmd "attachment" subcommand_required=#true help="Manage object attachments" {
    cmd "add" help="Add attachment to object" {
        arg "<PROJECT>" help="Project name"
        arg "<OID>" help="Object ID"
        arg "<FILENAME>" help="File to attach"
        
        flag "--content-type" help="MIME content type" {
            arg "<TYPE>"
        }
        flag "--attachment-name" help="Attachment name" {
            arg "<NAME>"
        }
    }
    
    cmd "get" help="Download attachment" {
        arg "<PROJECT>" help="Project name"
        arg "<OID>" help="Object ID"
        
        flag "--attachment-id" help="Attachment ID" {
            arg "<ID>"
        }
        flag "--attachment-name" help="Attachment name" {
            arg "<NAME>"
        }
    }
    
    cmd "list" help="List attachments" {
        arg "<PROJECT>" help="Project name"
        arg "<OID>" help="Object ID"
    }
    
    cmd "delete" help="Delete attachment" {
        arg "<PROJECT>" help="Project name"
        arg "<OID>" help="Object ID"
        
        flag "--attachment-id" help="Attachment ID" {
            arg "<ID>"
        }
        flag "--attachment-name" help="Attachment name" {
            arg "<NAME>"
        }
    }
}

cmd "list" help="Query and list objects with filters and aggregations" aliases="ls" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "[SUBSTRING]" help="Optional substring filter" required=#false
    // Filters
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<FILTER>"
    }
    // Pagination
    flag "--limit" help="Number of rows to return" {
        arg "<N>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<N>"
    }
    // Selection
    flag "--select" help="Select specific attributes" var=#true {
        arg "<ATTRIBUTE>"
    }
    flag "--select-wildcard" help="Select all attributes of type: physical|derived|virtual" {
        arg "<TYPE>" {
            choices physical derived virtual
        }
    }
    // Aggregations
    flag "--age" help="Relative timestamp (e.g., 1h, 1d)" {
        arg "<TIME>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<RANGE>"
    }
    flag "--unique" help="Count distinct values" {
        arg "<ATTRIBUTE>"
    }
    flag "--histogram" help="Show all distinct values" {
        arg "<ATTRIBUTE>"
    }
    flag "--distribution" help="Show truncated histogram" {
        arg "<ATTRIBUTE>"
    }
    flag "--mean" help="Calculate mean" {
        arg "<ATTRIBUTE>"
    }
    flag "--sum" help="Sum all values" {
        arg "<ATTRIBUTE>"
    }
    flag "--range" help="Show min and max values" {
        arg "<ATTRIBUTE>"
    }
    flag "--count" help="Count non-null values" {
        arg "<ATTRIBUTE>"
    }
    flag "--bin" help="Linear histogram of values" aliases="quantize" {
        arg "<ATTRIBUTE>"
    }
    flag "--head" help="First value in factor" {
        arg "<ATTRIBUTE>"
    }
    flag "--tail" help="Last value in factor" {
        arg "<ATTRIBUTE>"
    }
    flag "--object" help="Maximum object identifier" {
        arg "<ATTRIBUTE>"
    }
    // Aggregations (undocumented)
    flag "--last" help="Last object identifier" hide=#true {
        arg "<ATTRIBUTE>"
    }
    flag "--first" help="First object identifier" hide=#true {
        arg "<ATTRIBUTE>"
    }
    flag "--min" help="Min object identifier" hide=#true {
        arg "<ATTRIBUTE>"
    }
    flag "--max" help="Max object identifier" hide=#true {
        arg "<ATTRIBUTE>"
    }
    // Sorting
    flag "--sort" help="Sort results: [-](column|fold_term)" {
        arg "<TERM>"
    }
    // Computed Views
    flag "--quantize-uint" help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<SPEC>"
    }
    // Not documented
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<QUERY>"
    }
    flag "--table" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
        arg "<QUERY>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
        arg "<QUERY>"
    }
    flag "--reverse" help="Reverse sort order" {
        arg "<ATTRIBUTE>"
    }
    flag "--template" help="TODO: (ex: select)" { // TODO
        arg "<ATTRIBUTE>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<ATTRIBUTE>"
    }
    flag "--fingerprint" help="Filter by an exact fingerprint, or a regex anchored to the beginning of the fingerprint" { // TODO: better help/example
        arg "<VALUE>"
    }
    // Output options
    flag "--csv" help="Output to CSV file" {  // TODO: does this actually take a file path?
        arg "<FILE>"
    }
    flag "--json" help="Output JSON format"
    flag "--verbose" help="Show detailed query performance data"
}

cmd "delete" help="Delete objects by query or ID" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "[TARGET]..." help="Query or object IDs" var=#true required=#false
    flag "--physical-only" help="Delete only physical data (default)"
    flag "--crdb-only" help="Delete only indexed data"
    flag "--all" help="Delete all related data"
    flag "--filter" help="Filter expression" {
        arg "<FILTER>"
    }
}

cmd "project" subcommand_required=#true help="Manage projects" {
    cmd "create" help="Create new project" {
        arg "<NAME>" help="Project name"
    }
}

cmd "projects" subcommand_required=#true help="Manage projects" {
    cmd "list" help="List all projects"
}

cmd "flamegraph" help="Generate callstack flamegraph" {
    arg "<PROJECT>" help="Project name or universe/project"
    
    flag "--filter" help="Filter expression" {
        arg "<FILTER>"
    }
    flag "-o --output" help="Output SVG file" {
        arg "<FILE>"
    }
    flag "--reverse" help="Sample from leaf functions"
    flag "--unique" help="Sample only unique crashes"
}


cmd "symbold" subcommand_required=#true help="Manage symbold service" {
    cmd "status" help="Get symbold status" {
        arg "<PROJECT>" help="Project name"
    }
    
    cmd "symbolserver" subcommand_required=#true help="Manage symbol servers" {
        cmd "list" help="List symbol servers" {
            arg "<PROJECT>" help="Project name"
        }
        
        cmd "details" help="Get symbol server details" {
            arg "<ID>" help="Symbol server ID"
        }
        
        cmd "logs" help="Get symbol server logs" {
            arg "<ID>" help="Symbol server ID"
            
            cmd "filter" {
                arg "<FILTER>" help="Filter string"
            }

            flag "--take" help="Number of logs" {
                arg "<N>"
            }
            flag "--page" help="Page number" {
                arg "<N>"
            }
        }
        
        cmd "add" help="Add symbol server" {
            arg "<PROJECT>" help="Project name"
            arg "<URL>" help="Symbol server URL"
            
            flag "--name" help="Server name" required=#true {
                arg "<NAME>"
            }
            flag "--timeout" help="Download timeout" {
                arg "<MS>"
            }
            flag "--concurrentdownload" help="Max concurrent downloads" {
                arg "<N>"
            }
            flag "--retrylimit" help="Retry limit" {
                arg "<N>"
            }
            flag "--whitelist" help="Use whitelist" {
                arg "<BOOL>"
            }
            flag "--retain" help="Retain original symbols" {
                arg "<BOOL>"
            }
        }
        
        cmd "update" help="Update symbol server" {
            arg "<ID>" help="Symbol server ID"
            
            flag "--url" help="New URL" {
                arg "<URL>"
            }
            flag "--name" help="New name" {
                arg "<NAME>"
            }
        }

        cmd "disable" help="Disable symbol server" {
            arg "<ID>" help="Symbol server ID"
        }
                
        cmd "enable" help="Enable symbol server" {
            arg "<ID>" help="Symbol server ID"
        }
    }
    
    cmd "whitelist" subcommand_required=#true help="Manage whitelist" {
        cmd "add" help="Add to whitelist" {
            flag "--name" help="Item name" required=#true {
                arg "<NAME>"
            }
        }
        
        cmd "remove" help="Remove from whitelist" {
            arg "<ID>" help="Item ID" required=#true
        }
        
        cmd "list" help="List whitelist items" {
            flag "--page" help="Page number" {
                arg "<N>"
            }
            flag "--take" help="Items per page" {
                arg "<N>"
            }
        }
    }
    
    cmd "blacklist" subcommand_required=#true help="Manage blacklist" {
        cmd "add" help="Add to blacklist" {
            flag "--name" help="Item name" required=#true {
                arg "<NAME>"
            }
        }
        
        cmd "remove" help="Remove from blacklist" {
            arg "<ID>" help="Item ID" required=#true
        }
        
        cmd "list" help="List blacklist items" {
            flag "--page" help="Page number" {
                arg "<N>"
            }
            flag "--take" help="Items per page" {
                arg "<N>"
            }
        }
    }
    
    cmd "skiplist" subcommand_required=#true help="Manage skiplist" {
        cmd "find" help="Find items in skiplist" {
            arg "<SERVER_ID>" help="Symbol server ID"
            arg "<FILTER>" help="Filter string"
            
            flag "--page" help="Page number" {
                arg "<N>"
            }
            flag "--take" help="Items per page" {
                arg "<N>"
            }
        }
        
        cmd "remove" help="Remove from skiplist" {
            arg "[ID]" help="Item ID" required=#false // TODO: would be nice to specify "required unless all|filter cmd given"

            cmd "all" help="Remove all items" {
                arg "<SERVER_ID>" help="Symbol server ID"
            }
            
            cmd "filter" help="Remove by filter" {
                arg "<SERVER_ID>" help="Symbol server ID"
                arg "<FILTER>" help="Filter criteria"
            }
        }
    }
    
    cmd "queue" subcommand_required=#true help="Manage symbold queue" {
        cmd "list" help="List queue events"
        
        cmd "add" help="Add to queue" aliases="create" {
            arg "<PROJECT>" help="Universe/project"
            arg "<SYMBOL>" help="Missing symbol"
            arg "<OID>" help="Object ID"
        }
        
        cmd "size" help="Get queue size"
        
        cmd "symbold" help="List missing symbols from events"
    }
}

cmd "report" subcommand_required=#true help="Manage scheduled reports" {
    arg "<PROJECT>" help="Project name"
    
    cmd "list" help="List reports"

    cmd "create" help="Create report" {
        flag "--rcpt" help="Recipient email" required=#true var=#true {
            arg "<EMAIL>"
        }
        flag "--title" help="Report title" required=#true {
            arg "<TITLE>"
        }
        flag "--period" help="Period: week|day" required=#true {
            arg "<PERIOD>" {
                choices week day
            }
        }
        flag "--filter" help="Filter expression" {
            arg "<FILTER>"
        }
        flag "--fingerprint" help="Fingerprint filter" {
            arg "<FP>"
        }
        flag "--histogram" help="Include histogram" {
            arg "<ATTR>"
        }
        flag "--hour" help="Hour to send" {
            arg "<HOUR>"
        }
        flag "--day" help="Day to send" {
            arg "<DAY>"
        }
        // Undocumented create flags
        // See coronerReport, in: if (action === 'create') { ... }
        flag "--timezone" help="TImezone for report" hide=#true {
            arg "<TIMEZONE>"
        }
        flag "--include-users" help="Whether to include users in the report" hide=#true
        // Query flags (keep in sync with list command!)
        // Filters
        flag "--filter" help="Filter expression: attribute,operation,value" {
            arg "<FILTER>"
        }
        // Pagination
        flag "--limit" help="Number of rows to return" {
            arg "<N>"
        }
        flag "--offset" help="Skip first N rows" {
            arg "<N>"
        }
        // Selection
        flag "--select" help="Select specific attributes" var=#true {
            arg "<ATTRIBUTE>"
        }
        flag "--select-wildcard" help="Select all attributes of type: physical|derived|virtual" {
            arg "<TYPE>" {
                choices physical derived virtual
            }
        }
        // Aggregations
        flag "--age" help="Relative timestamp (e.g., 1h, 1d)" {
            arg "<TIME>"
        }
        flag "--time" help="Time range using natural language" {
            arg "<RANGE>"
        }
        flag "--unique" help="Count distinct values" {
            arg "<ATTRIBUTE>"
        }
        flag "--histogram" help="Show all distinct values" {
            arg "<ATTRIBUTE>"
        }
        flag "--distribution" help="Show truncated histogram" {
            arg "<ATTRIBUTE>"
        }
        flag "--mean" help="Calculate mean" {
            arg "<ATTRIBUTE>"
        }
        flag "--sum" help="Sum all values" {
            arg "<ATTRIBUTE>"
        }
        flag "--range" help="Show min and max values" {
            arg "<ATTRIBUTE>"
        }
        flag "--count" help="Count non-null values" {
            arg "<ATTRIBUTE>"
        }
        flag "--bin" help="Linear histogram of values" aliases="quantize" {
            arg "<ATTRIBUTE>"
        }
        flag "--head" help="First value in factor" {
            arg "<ATTRIBUTE>"
        }
        flag "--tail" help="Last value in factor" {
            arg "<ATTRIBUTE>"
        }
        flag "--object" help="Maximum object identifier" {
            arg "<ATTRIBUTE>"
        }
        // Aggregations (undocumented)
        flag "--last" help="Last object identifier" hide=#true {
            arg "<ATTRIBUTE>"
        }
        flag "--first" help="First object identifier" hide=#true {
            arg "<ATTRIBUTE>"
        }
        flag "--min" help="Min object identifier" hide=#true {
            arg "<ATTRIBUTE>"
        }
        flag "--max" help="Max object identifier" hide=#true {
            arg "<ATTRIBUTE>"
        }
        // Sorting
        flag "--sort" help="Sort results: [-](column|fold_term)" {
            arg "<TERM>"
        }
        // Computed Views
        flag "--quantize-uint" help="Compute quantized column: output_column,input_column,size[,offset]" {
            arg "<SPEC>"
        }
        // Not documented
        flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
            arg "<QUERY>"
        }
        flag "--table" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
            arg "<QUERY>"
        }
        flag "--timestamp-attribute" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
            arg "<QUERY>"
        }
        flag "--reverse" help="Reverse sort order" {
            arg "<ATTRIBUTE>"
        }
        flag "--template" help="TODO: (ex: select)" { // TODO
            arg "<ATTRIBUTE>"
        }
        flag "--factor" help="Group by attribute" {
            arg "<ATTRIBUTE>"
        }
        flag "--fingerprint" help="Filter by an exact fingerprint, or a regex anchored to the beginning of the fingerprint" { // TODO: better help/example
            arg "<VALUE>"
        }
    }
    
    cmd "delete" help="Delete report" {
        arg "<ID>" help="Report ID"
    }
    
    cmd "send" help="Send report immediately"
}

cmd "merge" help="Merge fingerprints into group" {
    arg "<PROJECT>" help="Project name"
    arg "<FINGERPRINTS>" help="Fingerprints to merge" var=#true
}

cmd "unmerge" help="Unmerge fingerprints from group" {
    arg "<PROJECT>" help="Project name"
    arg "<FINGERPRINTS>" help="Fingerprints to unmerge" var=#true
}

cmd "repair" help="Repair project's attribute database" {
    arg "<PROJECT>" help="Project name or universe/project"
}

cmd "reprocess" help="Reprocess objects" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<TARGET>" help="Query or object IDs" var=#true required=#false
    
    flag "--first" help="First object ID" {
        arg "<N>"
    }
    flag "--last" help="Last object ID" {
        arg "<N>"
    }
}

cmd "retention" subcommand_required=#true help="Configure retention policy" {
    cmd "list" help="List retention policies" {

    }
    
    cmd "set" help="Set retention policy" {
        arg "<NAME>" help="Namespace name" // TODO: might be optional
        
        flag "--dryrun" help="Show command without executing"
        flag "--type" help="Type: instance|universe|project" {
            arg "<TYPE>" {
                choices instance universe project
            }
        }
        flag "--rules" help="Number of rules" {
            arg "<N>"
        }
        flag "--age" help="Object age: [R,]O,T[,TE]" {
            arg "<SPEC>"
        }
        flag "--max-age" help="Max age in seconds" {
            arg "<N>"
        }
        flag "--compress" help="Compress matching objects" {
            arg "<RULE>"
        }
        flag "--delete" help="Delete subsets: physical|crdb" {
            arg "<SUBSETS>"
        }
        flag "--physical-only" help="Delete only physical data" {
            arg "<RULE>"
        }
    }
    
    cmd "status" help="Get retention status" {
        arg "<NAME>" help="Namespace name"

        flag "--type" help="Type: universe|project" {
            arg "<TYPE>" default="project" {
                choices universe project
            }
        }
    }
    
    cmd "clear" help="Clear retention policy" {
        arg "<NAME>" help="Namespace name"
        
        flag "--type" help="Type: project" {
            arg "<TYPE>" {
                choices instance universe project
            }
        }
    }
}

cmd "sampling" subcommand_required=#true help="Manage object sampling" {
    cmd "status" help="Get sampling status" {
        flag "--fingerprint" help="Specific fingerprint" {
            arg "<FP>"
        }
        flag "--project" help="Specific project" {
            arg "<PROJECT>"
        }
        flag "--max-groups" help="Max groups to display" {
            arg "<N>"
        }
    }
    
    cmd "reset" help="Reset sampling" {
        flag "--fingerprint" help="Specific fingerprint" {
            arg "<FP>"
        }
        flag "--project" help="Specific project" {
            arg "<PROJECT>"
        }
    }
    
    cmd "configure" help="Configure sampling" {
        flag "--project" help="Project name" required=#true {
            arg "<PROJECT>"
        }
        flag "--universe" help="Universe name" {
            arg "<UNIVERSE>"
        }
        flag "--disable" help="Disable sampling"
        flag "--clear" help="Clear project config"
        flag "--attribute" help="Sample by attribute" {
            arg "<ATTR>"
        }
        flag "--backoff" help="Backoff: count,interval" {
            arg "<SPEC>"
        }
        flag "--buckets" help="Max sampling buckets" {
            arg "<N>"
        }
        flag "--process-whitelisted" help="Sample whitelisted symbols" {
            arg "<BOOL>"
        }
        flag "--process-private" help="Sample private symbols" {
            arg "<BOOL>"
        }
        flag "--reset-interval" help="Reset interval" {
            arg "<INTERVAL>"
        }
    }
}

cmd "symbol" help="Manage debug symbols" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "[ACTION]" help="Action: summary|list|missing|archives" required=#false default=summary {
        choices summary list missing archives
    }
    flag "--tag" help="Filter by tag" {
        arg "<TAG>"
    }
    flag "--filter" help="Filter symbols" {
        arg "<FILTER>"
    }
    flag "--json" help="JSON output"
    flag "-o --output" help="Output to file" {
        arg "<FILE>"
    }
}

// TODO: double check this
cmd "scrubber" subcommand_required=#true help="Manage data scrubbers" {
    arg "<PROJECT>" help="Project name"
    
    cmd "list" help="List scrubbers"
    
    cmd "create" help="Create scrubber" {
        flag "--name" help="Scrubber name" required=#true {
            arg "<NAME>"
        }
        flag "--regexp" help="Pattern to match" {
            arg "<PATTERN>"
        }
        flag "--builtin" help="Builtin: ssn|ccn|key|env|all" {
            arg "<TYPE>"
        }
        flag "--enable" help="Enable scrubber" {
            arg "<VALUE>"
        }
    }
    
    cmd "modify" help="Modify scrubber" {
        flag "--name" help="Scrubber name" required=#true {
            arg "<NAME>"
        }
        flag "--regexp" help="New pattern" {
            arg "<PATTERN>"
        }
        flag "--enable" help="Enable/disable" {
            arg "<VALUE>"
        }
    }
    
    cmd "delete" help="Delete scrubber" {
        flag "--name" help="Scrubber name" required=#true {
            arg "<NAME>"
        }
    }
}

cmd "setup" help="Configure initial organization and user for on-premise server" {
    arg "<URL>" help="Server URL"
}

cmd "nuke" help="Delete object and dependencies" {
    flag "--universe" help="Universe name" required=#true {
        arg "<UNIVERSE>"
    }
    flag "--project" help="Project name" {
        arg "<PROJECT>"
    }
}

cmd "token" subcommand_required=#true help="Manage API tokens" {
    cmd "create" help="Create token" {
        flag "--project" help="Project name" required=#true {
            arg "<PROJECT>"
        }
        flag "--capability" help="Capability: symbol:post|error:post|query:post|sync:post" required=#true var=#true {
            arg "<CAP>"
        }
    }
    
    cmd "list" help="List tokens" {
        flag "--universe" help="Universe name" {
            arg "<UNIVERSE>"
        }
        flag "--project" help="Project name" {
            arg "<PROJECT>"
        }
    }
    
    cmd "delete" help="Delete token" {
        arg "<TOKEN>" help="Token SHA256 or prefix"
    }
}

cmd "user" subcommand_required=#true help="Manage users" {
    cmd "reset" help="Reset user password" {
        flag "--universe" help="Universe name" {
            arg "<UNIVERSE>"
        }
        flag "--user" help="Username" {
            arg "<USER>"
        }
        flag "--password" help="New password" {
            arg "<PASSWORD>"
        }
        flag "--role" help="User role" {
            arg "<ROLE>"
        }
    }
}

cmd "users" subcommand_required=#true help="Manage users" {
    cmd "add-signup-whitelist" help="Add domain to signup whitelist" {
        flag "--universe" help="Universe name" {
            arg "<UNIVERSE>"
        }
        flag "--domain" help="Domain name" {
            arg "<DOMAIN>"
        }
        flag "--role" help="Default role" {
            arg "<ROLE>"
        }
        flag "--method" help="Auth method" {
            arg "<METHOD>"
        }
    }
    
    cmd "list-teamless-users" help="List users not in any team"
}

cmd "tenant" subcommand_required=#true help="Manage isolated tenants (enterprise)" {
    cmd "create" help="Create tenant" {
        arg "<NAME>" help="Tenant name"
    }
    
    cmd "delete" help="Delete tenant" {
        arg "<NAME>" help="Tenant name"
    }
    
    cmd "list" help="List all tenants"
}

cmd "similarity" help="Compute crash group similarity" {
    arg "<PROJECT>" help="Project name or universe/project"
    arg "<FILTER>" help="Filter expression" required=#false
    
    flag "--threshold" help="Min callstack length" {
        arg "<N>"
    }
    flag "--truncate" help="Shorten callstack before comparing" {
        arg "<N>"
    }
    flag "--intersection" help="Min common symbols" {
        arg "<N>"
    }
    flag "--distance" help="Max edit distance" {
        arg "<N>"
    }
    flag "--fingerprint" help="Compare to specific fingerprint" {
        arg "<FP>"
    }
    flag "--json" help="Return JSON result"
}

