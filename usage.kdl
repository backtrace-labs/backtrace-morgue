        cmd "list" help="List connections" {
            flag "--raw" help="Output raw JSON"
        }

        cmd "get" help="Get connection" {
            arg "<id>" help="Connection ID"
            flag "--raw" help="Output raw JSON"
        }

        cmd "update" help="Update connection" {
            arg "<id>" help="Connection ID"
            flag "--name" help="New name" {
                arg "<name>"
            }
            flag "--options" help="New options" {
                arg "<json>"
            }
            flag "--from-file" help="Load from file" {
                arg "<file>"
            }
            flag "--raw" help="Output raw JSON"
        }

        cmd "delete" help="Delete connection" {
            arg "<id>" help="Connection ID"
            flag "--raw" help="Output raw JSON"
        }
    }

    cmd "integration" subcommand_required=#true help="Manage integrations" {
        cmd "create" help="Create integration" {
            flag "--project" help="Project name" required=#true {
                arg "<project>"
            }
            flag "--name" help="Integration name" required=#true {
                arg "<name>"
            }
            flag "--plugin" help="Plugin ID" required=#true {
                arg "<id>"
            }
            flag "--options" help="Plugin options" required=#true {
                arg "<json>"
            }
            flag "--state" help="Initial state to set for the integration" {
                arg "<state>" {
                    choices enabled disabled stopped
                }
            }
            flag "--connection" help="Connection ID" {
                arg "<id>"
            }
            flag "--synchronize-issues" help="Enable issue sync" {
                arg "<bool>"
            }
            flag "--synchronize-issues-on-add" help="Sync on add" {
                arg "<bool>"
            }
            flag "--from-file" help="Load from file" {
                arg "<file>"
            }
            flag "--raw" help="Output raw JSON"
        }

        cmd "list" help="List integrations" {
            flag "--raw" help="Output raw JSON"
        }

        cmd "get" help="Get integration" {
            arg "<id>" help="Integration ID"
            flag "--raw" help="Output raw JSON"
        }

        cmd "update" help="Update integration" {
            arg "<id>" help="Integration ID"
            flag "--options" help="New options" {
                arg "<json>"
            }
            flag "--state" help="New state" {
                arg "<state>"
            }
            flag "--connection" help="New connection ID" {
                arg "<id>"
            }
            flag "--from-file" help="Load from file" {
                arg "<file>"
            }
            flag "--raw" help="Output raw JSON"
        }

        cmd "delete" help="Delete integration" {
            arg "<id>" help="Integration ID"
            flag "--raw" help="Output raw JSON"
        }
    }

    cmd "alert" subcommand_required=#true help="Manage workflow alerts" {
        cmd "list" help="List workflow alerts" {
            flag "--raw" help="Output raw JSON"
        }

        cmd "get" help="Get workflow alert" {
            arg "<id>" help="Alert ID"
            flag "--raw" help="Output raw JSON"
        }

        cmd "create" help="Create workflow alert" {
            flag "--project" help="Project name" required=#true {
                arg "<project>"
            }
            flag "--name" help="Alert name" required=#true {
                arg "<name>"
            }
            flag "--condition.name" help="Condition type" required=#true {
                arg "<type>"
            }
            flag "--frequency" help="Frequency in ms" required=#true {
                arg "<ms>"
            }
            flag "--execution-delay" help="Delay in ms" {
                arg "<ms>"
            }
            flag "--state" help="Initial state to set for the integration" {
                arg "<state>" {
                    choices enabled disabled stopped
                }
            }
            flag "--filter" help="Filter expression" {
                arg "<filter>"
            }
            flag "--integration" help="Integration ID" {
                arg "<id>"
            }
            flag "--from-file" help="Load from file" {
                arg "<file>"
            }
            flag "--raw" help="Output raw JSON"
        }

        cmd "update" help="Update workflow alert" {
            arg "<id>" help="Alert ID"
            flag "--name" help="New name" {
                arg "<name>"
            }
            flag "--from-file" help="Load from file" {
                arg "<file>"
            }
            flag "--raw" help="Output raw JSON"
        }

        cmd "delete" help="Delete workflow alert" {
            arg "<id>" help="Alert ID"
            flag "--raw" help="Output raw JSON"
        }
    }
}

cmd "actions" subcommand_required=#true help="Manage actions configuration" {
    cmd "get" help="Display actions config" {
        flag "--universe" help="Universe name" {
            arg "<universe>"
        }
        flag "--project" help="Project name" required=#true {
            arg "<project>"
        }
    }

    cmd "disable" help="Disable actions" {
        flag "--universe" help="Universe name" {
            arg "<universe>"
        }
        flag "--project" help="Project name" required=#true {
            arg "<project>"
        }
    }

    cmd "enable" help="Enable actions" {
        flag "--universe" help="Universe name" {
            arg "<universe>"
        }
        flag "--project" help="Project name" required=#true {
            arg "<project>"
        }
    }

    cmd "upload" help="Upload actions config" {
        arg "<path>" help="Config file path"
        flag "--universe" help="Universe name" {
            arg "<universe>"
        }
        flag "--project" help="Project name" required=#true {
            arg "<project>"
        }
    }

    cmd "delete" help="Delete actions config" {
        flag "--universe" help="Universe name" {
            arg "<universe>"
        }
        flag "--project" help="Project name" required=#true {
            arg "<project>"
        }
    }
}

cmd "attribute" subcommand_required=#true help="Manage project attributes" {
    cmd "create" help="Create attribute" {
        arg "<project>" help="Project name"
        arg "<name>" help="Attribute name"

        flag "--description" help="Attribute description" {
            arg "<desc>"
        }
        flag "--type" help="Attribute value type" {
            arg "<type>" {
                choices bitmap uint8 uint16 uint32 uint64 uint128 uuid dictionary
            }
        }
        flag "--format" help="Attribute display format" {
            arg "<format>" {
                choices none commit semver callstack hostname bytes kilobytes gigabytes nanoseconds milliseconds seconds unix_timestamp js_timestamp gps_timestamp memory_address labels sha256 uuid ipv4 ipv6
            }
        }
    }

    cmd "delete" help="Delete attribute" {
        arg "<project>" help="Project name"
        arg "<name>" help="Attribute name"
    }
}

cmd "view" subcommand_required=#true help="Manage query views" {
    cmd "create" help="Create view" {
        arg "<project>" help="Project name"
        arg "<name>" help="View name"

        flag "--queries" help="Queries JSON file" {
            arg "<file>"
        }
        flag "--payload" help="Payload JSON file" {
            arg "<file>"
        }
    }

    cmd "delete" help="Delete view" {
        arg "<project>" help="Project name"
        arg "<name>" help="View name"
    }
}

// Hidden/internal commands
cmd "error" help="Throw test error" hide=#true {
    arg "<message>" help="Error message"
}

cmd "log" help="Managed log operations" hide=#true {
    cmd "list" help="List available logs"
    cmd "activate" help="Activate a log" {
        arg "<name>" help="Log name"
    }
    cmd "deactivate" help="Deactivate a log" {
        arg "<name>" help="Log name"
    }
    cmd "extract" help="Extract log entries" {
        arg "<name>" help="Log name"
        flag "--json" help="Output JSON format"
        flag "--table" help="Output as table"
    }
}

cmd "audit" help="Audit log operations" hide=#true {
    cmd "extract" help="Extract audit log" {
        flag "--json" help="Output JSON format"
        flag "--table" help="Output as table"
    }
}
cmd "bpg" help="BPG operations" hide=#true {
    flag "--raw" help="Raw BPG JSON request" {
        arg "<json>"
    }

    cmd "list" help="List BPG objects of a given type" {
        arg "<type>" help="BPG type (e.g. configuration/project)"
    }
}
cmd "control" help="Trigger control operations" hide=#true {
    flag "--smr" help="Trigger grace period"
}

cmd "deduplication" subcommand_required=#true help="Manage deduplication rules" hide=#true {
    arg "<project>" help="Universe/project"

    cmd "add" help="Add deduplication rules" {
        flag "--name" help="Rule name" required=#true {
            arg "<name>"
        }
        flag "--rules" help="Rules JSON file" required=#true {
            arg "<file>"
        }
        flag "--priority" help="Rule priority" {
            arg "<n>"
        }
        flag "--platform" help="Platform filter" {
            arg "<platform>"
        }
        flag "--owner" help="Owner user ID" hide=#true {
            arg "<uid>"
        }
    }

    cmd "delete" help="Delete deduplication rule" {
        flag "--name" help="Rule name" required=#true {
            arg "<name>"
        }
    }

    cmd "modify" help="Modify deduplication rule" {
        flag "--name" help="Rule name" required=#true {
            arg "<name>"
        }
        flag "--rules" help="Rules JSON file" {
            arg "<file>"
        }
        flag "--priority" help="Rule priority" {
            arg "<n>"
        }
    }

    cmd "list" help="List deduplication rules" {
        flag "--name" help="Filter by rule name" {
            arg "<name>"
        }
        flag "--verbose" help="Show detailed rule info"
    }
}

cmd "latency" help="Latency histogram testing" hide=#true {
    cmd "list" help="List available histograms" {
        arg "[pattern]" help="Regex filter" required=#false
    }
    cmd "activate" help="Activate histogram" {
        arg "<name>" help="Histogram name"
        flag "--samples" help="Number of samples" {
            arg "<n>"
        }
    }
    cmd "deactivate" help="Deactivate histogram" {
        arg "<name>" help="Histogram name"
    }
    cmd "extract" help="Extract histogram data" {
        arg "<name>" help="Histogram name"
        flag "--raw" help="Output raw values"
    }
}

cmd "cts" help="Set marker for uniquely introduced issues" hide=#true {
    arg "<project>" help="Project name"
    arg "<attribute>" help="Attribute name"
    arg "<value>" help="Target value"
    flag "--query" help="Show query JSON without executing"
}

cmd "session" help="Manage session resource overrides" hide=#true {
    cmd "list" help="List active sessions" {
        flag "--scope" help="Session scope" {
            arg "<scope>" {
                choices global user session
            }
        }
        flag "-g" help="Shorthand for --scope=global"
        flag "-u" help="Shorthand for --scope=user"
        flag "-s" help="Shorthand for --scope=session"
    }
    cmd "set" help="Set resource override values" {
        arg "<resources_json>" help="JSON object of resources"
        flag "--persist" help="Persist to configuration" {
            arg "<scope>" {
                choices universe user
            }
        }
        flag "--uid" help="User ID for persistence" {
            arg "<uid>"
        }
    }
    cmd "unset" help="Unset resource override values" {
        arg "<resource_names>" help="Resource names to unset" var=#true
    }
}

cmd "limit" help="Manage submission limits" hide=#true {
    cmd "list" help="List current limits"
    cmd "reset" help="Reset limits for a universe"
    cmd "delete" help="Delete limits for a universe"
    cmd "create" help="Create submission limit" {
        flag "--submissions" help="Submission limit" required=#true {
            arg "<n>"
        }
        flag "--metadata" help="Metadata JSON" {
            arg "<json>"
        }
    }
}

cmd "service" help="Service layer operations" hide=#true {
    cmd "list" help="List services"
    cmd "status" help="Get service status"
    cmd "rescan" help="Rescan services"
}

cmd "status" help="Server status operations" hide=#true {
    cmd "reload" help="Get reload status"
}
