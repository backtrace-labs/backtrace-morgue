// morgue CLI Usage Specification
// https://usage.jdx.dev/spec/

name "morgue"
bin "morgue"
about "Command-line interface to the Backtrace object store"
version "from-package-json"

// Global flags
flag "--endpoint" help="Specify API endpoint" global=#true {
    arg "<url>"
}
flag "--token" help="Specify API token" global=#true {
    // alias "api-token"
    arg "<token>"
}
flag "--universe" help="Universe name" global=#true {
    arg "<universe>"
}
flag "--project" help="Project name" global=#true {
    arg "<project>"
}
flag "--timeout" help="Set the timeout on API requests in milliseconds" global=#true {
    arg "<ms>"
}
flag "-h --help" help="Print help and exit" global=#true
flag "-v --version" help="Print version number and exit"
flag "--debug" help="Enable verbose debug printing" global=#true
flag "-k" help="Disable SSL verification with CA"  global=#true

// Commands

cmd "login" help="Log into a Backtrace server" {
    arg "<url>" help="Server URL (e.g., http://localhost)"

    long_help #"""
        The first step to using `morgue` is to log into a server.
        """#

    after_long_help #"""
        The first step to using `morgue` is to log into a server.

        ```
        $ morgue login http://localhost
        User: sbahra
        Password: **************

        Logged in.
        ```

        At this point, you are able to issue queries.

        If you need to log in from a CI context, it is possible to set the
        environment variables `MORGUE_USERNAME` and `MORGUE_PASSWORD`. If these
        variables are set, the interactive prompt will be suppressed, and the values
        in the aforementioned environment variables used instead.

        For non-interactive token-based login, use the global `--token` flag:

        ```
        $ morgue login http://localhost --token=<your-api-token>
        ```

        If you have SSO enabled please follow [this document](https://docs.saucelabs.com/error-reporting/troubleshooting/#how-can-i-login-to-the-morgue-tool-via-sso) to log in with a token.
        """#
}

cmd "logout" help="Log out from the current Backtrace server."

cmd "clean" help="Apply sampling retroactively." {
    arg "<project>" help="Project name or universe/project"

    flag "--keep" help="Number of objects to keep per fingerprint" {
        arg "<n>"
    }
    flag "--oldest" help="Keep N oldest objects" {
        arg "<n>"
    }
    flag "--output" help="Output object IDs to stdout"
    flag "--verbose" help="Verbose output"

    // argvQuery
    // Filters
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<filter>"
    }
    // Pagination
    flag "--limit" help="Number of rows to return" {
        arg "<n>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<n>"
    }
    // Selection
    flag "--select" help="Select specific attributes" var=#true {
        arg "<attribute>"
    }
    flag "--select-wildcard" help="Select all attributes of the given type" {
        arg "<type>" {
            choices physical derived virtual
        }
    }
    // Aggregations
    flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
        arg "<time>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<range>"
    }
    flag "--unique" help="Count distinct values" {
        arg "<attribute>"
    }
    flag "--histogram" help="Show all distinct values" {
        arg "<attribute>"
    }
    flag "--distribution" help="Show truncated histogram" {
        arg "<attribute>"
    }
    flag "--mean" help="Calculate mean" {
        arg "<attribute>"
    }
    flag "--sum" help="Sum all values" {
        arg "<attribute>"
    }
    flag "--range" help="Show min and max values" {
        arg "<attribute>"
    }
    flag "--count" help="Count non-null values" {
        arg "<attribute>"
    }
    flag "--bin" help="Linear histogram of values" {
        // alias "quantize"
        arg "<attribute>"
    }
    flag "--head" help="First value in factor" {
        arg "<attribute>"
    }
    flag "--tail" help="Last value in factor" {
        arg "<attribute>"
    }
    flag "--object" help="Maximum object identifier" {
        arg "<attribute>"
    }
    // Aggregations (undocumented)
    flag "--last" help="Last object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--first" help="First object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--min" help="Min object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--max" help="Max object identifier" hide=#true {
        arg "<attribute>"
    }
    // Sorting
    flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
        arg "<term>"
    }
    // Computed Views
    flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<spec>"
    }
    // Not documented
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<query>"
    }
    flag "--table" help="Table to query against" hide=#true {
        arg "<query>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp" hide=#true {
        arg "<query>"
    }
    flag "--reverse" help="Reverse sort order" {
        arg "<attribute>"
    }
    flag "--template" help="Use a server-side named query template (e.g. select)" {
        arg "<attribute>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<attribute>"
    }
    flag "--fingerprint" help="Filter by fingerprint: exact match (64 chars) or prefix regex" {
        arg "<value>"
    }

    before_long_help #"""
        Retroactively apply sampling on a fingerprint. The default is to keep
        3 objects retained for every fingerprint. This is configurable. Also
        configurable is keeping the oldest N objects for every fingerprint.
        """#

    long_help #"""
        If --output is set, then all object identifiers are output to stdout. Statistics
        are output to stderr. It is then possible to chain this into morgue delete:

        ```
        $ morgue clean blackhole --output > file.txt
        $ cat file.txt | xargs -n 8192 morgue delete blackhole --physical-only
        ```
        """#
}

cmd "describe" help="Requests a list and description of all metadata that can be queried against." {
    arg "<project>" help="Project name or universe/project"
    arg "<substring>" help="Filter by substring" required=#false

    flag "-r" help="Show disabled attributes"
    flag "-u" help="Show only custom attributes"
    flag "-a" help="Show all attributes including unused"
    flag "-l" help="Show filter and aggregation info"
    flag "--json" help="Output JSON format"
    flag "--table" help="Table to query against" hide=#true {
        arg "<table>"
    }

    after_long_help #"""
        Examples:

        ```
        $ morgue describe bidder uname
                    uname.machine: machine hardware name
                    uname.release: kernel release
                    uname.sysname: kernel name
                    uname.version: kernel version
        ```
        """#
}

cmd "get" help="Download object from the Backtrace object store." {
    arg "<project>" help="Project name or universe/project"
    arg "<object_id>" help="Object identifier"

    flag "-o --output" help="Output to file" {
        arg "<file>"
    }
    flag "--resource" help="Fetch specific resource" {
        arg "<name>"
    }
    flag "--outdir" help="Output directory for multiple objects" hide=#true {
        arg "<dir>"
    }
    flag "--first" help="First object ID in range" hide=#true {
        arg "<id>"
    }
    flag "--last" help="Last object ID in range" hide=#true {
        arg "<id>"
    }

    long_help #"""
        Downloads the specified object from the Backtrace object store and prints to standard output.
        Optionally, output the file to disk.
        """#
}

cmd "put" help="Uploads object file to the Backtrace object store." {
    arg "<project>" help="Project name or universe/project"
    arg "<file>" help="File to upload"

    flag "--format" help="File format" required=#true {
        arg "<format>" {
            choices btt minidump json plcrash symbols symbols-proguard sourcemap
        }
    }
    flag "--compression" help="Compression: gzip|deflate" {
        arg "<type>" {
            choices gzip deflate
        }
    }
    flag "--kv" help="Key-value pairs: key1:value1,key2:value2" {
        arg "<pairs>"
    }
    flag "--form_data" help="Upload using multipart/form-data POST request"
    flag "--tag" help="Symbol tag (used with symbols format)" hide=#true {
        arg "<tag>"
    }
    flag "--symbolication-id" help="Symbolication identifier" hide=#true {
        arg "<id>"
    }
    flag "--sync" help="Synchronous submission" hide=#true
    flag "--reuse" help="Reuse HTTP connections" hide=#true
    flag "--attachment" help="Attachment file(s) for minidump uploads" hide=#true {
        arg "<file>"
    }
    flag "--multipart" help="Force multipart form submission" hide=#true
    flag "--benchmark" help="Run submission benchmark" hide=#true
    flag "--samples" help="Number of benchmark samples" hide=#true {
        arg "<n>"
    }
    flag "--concurrency" help="Benchmark concurrency level" hide=#true {
        arg "<n>"
    }
    flag "--printids" help="Print object IDs after upload" hide=#true
}

cmd "set" help="Modify object attributes" {
    arg "<project>" help="Project name or universe/project"
    arg "<query>" help="Query or object ID"
    arg "<assignment>" help="key=value assignment"

    // Query flags (keep in sync with list command!) argvQuery
    // Filters
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<filter>"
    }
    // Pagination
    flag "--limit" help="Number of rows to return" {
        arg "<n>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<n>"
    }
    // Selection
    flag "--select" help="Select specific attributes" var=#true {
        arg "<attribute>"
    }
    flag "--select-wildcard" help="Select all attributes of the given type" {
        arg "<type>" {
            choices physical derived virtual
        }
    }
    // Aggregations
    flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
        arg "<time>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<range>"
    }
    flag "--unique" help="Count distinct values" {
        arg "<attribute>"
    }
    flag "--histogram" help="Show all distinct values" {
        arg "<attribute>"
    }
    flag "--distribution" help="Show truncated histogram" {
        arg "<attribute>"
    }
    flag "--mean" help="Calculate mean" {
        arg "<attribute>"
    }
    flag "--sum" help="Sum all values" {
        arg "<attribute>"
    }
    flag "--range" help="Show min and max values" {
        arg "<attribute>"
    }
    flag "--count" help="Count non-null values" {
        arg "<attribute>"
    }
    flag "--bin" help="Linear histogram of values" {
        // alias "quantize"
        arg "<attribute>"
    }
    flag "--head" help="First value in factor" {
        arg "<attribute>"
    }
    flag "--tail" help="Last value in factor" {
        arg "<attribute>"
    }
    flag "--object" help="Maximum object identifier" {
        arg "<attribute>"
    }
    // Aggregations (undocumented)
    flag "--last" help="Last object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--first" help="First object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--min" help="Min object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--max" help="Max object identifier" hide=#true {
        arg "<attribute>"
    }
    // Sorting
    flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
        arg "<term>"
    }
    // Computed Views
    flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<spec>"
    }
    // Not documented
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<query>"
    }
    flag "--table" help="Table to query against" hide=#true {
        arg "<query>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp" hide=#true {
        arg "<query>"
    }
    flag "--reverse" help="Reverse sort order" {
        arg "<attribute>"
    }
    flag "--template" help="Use a server-side named query template (e.g. select)" {
        arg "<attribute>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<attribute>"
    }
    flag "--fingerprint" help="Filter by fingerprint: exact match (64 chars) or prefix regex" {
        arg "<value>"
    }

    long_help #"""
        Modifies attributes of the given object in the manner specified.
        """#


    after_long_help #"""
        Example:

        Set custom attribute `reason` to `oom` for all crashes containing `memory_abort`.

        ```
        $ morgue set reason=oom --filter=callstack,regular-expression,memory_abort
        ```

        Set `reason` to `boomboom` for object `cb`.

        ```
        $ morgue set reason=boomboom --filter=_tx,equal,206
        ```
        """#
}

cmd "attachment" subcommand_required=#true help="Manage object attachments" {
    cmd "add" help="Add attachment to object" {
        arg "<project>" help="Project name"
        arg "<oid>" help="Object ID"
        arg "<filename>" help="File to attach"

        flag "--content-type" help="Content-Type for attachment" {
            arg "<id>"
        }
        flag "--attachment-name" help="Attachment name" {
            arg "<name>"
        }
    }

    cmd "get" help="Download attachment" {
        arg "<project>" help="Project name"
        arg "<oid>" help="Object ID"

        flag "--attachment-id" help="Attachment ID" /*required_unless="--attachment-name"*/ {
            arg "<id>"
        }
        flag "--attachment-name" help="Attachment name" /*required_unless="--attachment-id"*/ {
            arg "<name>"
        }
    }

    cmd "list" help="List attachments" {
        arg "<project>" help="Project name"
        arg "<oid>" help="Object ID"
    }

    cmd "delete" help="Delete attachment" {
        arg "<project>" help="Project name"
        arg "<oid>" help="Object ID"

        flag "--attachment-id" help="Attachment ID" /*required_unless="--attachment-name"*/ {
            arg "<id>"
        }
        flag "--attachment-name" help="Attachment name" /*required_unless="--attachment-id"*/ {
            arg "<name>"
        }
    }
}

cmd "list" help="Query and list objects with filters and aggregations" {
    // alias "ls"
    arg "<project>" help="Project name or universe/project"
    arg "[substring]" help="Optional substring filter" required=#false

    // These are parsed by the argvQuery function
    // Filters
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<filter>"
    }
    // Pagination
    flag "--limit" help="Number of rows to return" {
        arg "<n>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<n>"
    }
    // Selection
    flag "--select" help="Select specific attributes" var=#true {
        arg "<attribute>"
    }
    flag "--select-wildcard" help="Select all attributes of the given type" {
        arg "<type>" {
            choices physical derived virtual
        }
    }
    // Aggregations
    flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
        arg "<time>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<range>"
    }
    flag "--unique" help="Count distinct values" {
        arg "<attribute>"
    }
    flag "--histogram" help="Show all distinct values" {
        arg "<attribute>"
    }
    flag "--distribution" help="Show truncated histogram" {
        arg "<attribute>"
    }
    flag "--mean" help="Calculate mean" {
        arg "<attribute>"
    }
    flag "--sum" help="Sum all values" {
        arg "<attribute>"
    }
    flag "--range" help="Show min and max values" {
        arg "<attribute>"
    }
    flag "--count" help="Count non-null values" {
        arg "<attribute>"
    }
    flag "--bin" help="Linear histogram of values" {
        // alias "quantize"
        arg "<attribute>"
    }
    flag "--head" help="First value in factor" {
        arg "<attribute>"
    }
    flag "--tail" help="Last value in factor" {
        arg "<attribute>"
    }
    flag "--object" help="Maximum object identifier" {
        arg "<attribute>"
    }
    // Aggregations (undocumented)
    flag "--last" help="Last object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--first" help="First object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--min" help="Min object identifier" hide=#true {
        arg "<attribute>"
    }
    flag "--max" help="Max object identifier" hide=#true {
        arg "<attribute>"
    }
    // Sorting
    flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
        arg "<term>"
    }
    // Computed Views
    flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<spec>"
    }
    // Not documented
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<query>"
    }
    flag "--table" help="Table to query against" hide=#true {
        arg "<query>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp" hide=#true {
        arg "<query>"
    }
    flag "--reverse" help="Reverse sort order" {
        arg "<attribute>"
    }
    flag "--template" help="Use a server-side named query template (e.g. select)" {
        arg "<attribute>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<attribute>"
    }
    flag "--fingerprint" help="Filter by fingerprint: exact match (64 chars) or prefix regex" {
        arg "<value>"
    }

    // Output options
    flag "--csv" help="Output results to a CSV file" {
        arg "<file>"
    }
    flag "--json" help="Output JSON format"
    flag "--query" help="Show the built query JSON and exit without performing the request"
    flag "--verbose" help="Show detailed query performance data"
    flag "--raw" help="Output raw JSON response (use with --query to also execute)" hide=#true
    flag "--set" help="Set attributes on matching objects: key=value" hide=#true {
        arg "<assignment>"
    }
    flag "--clear" help="Clear attributes on matching objects" hide=#true {
        arg "<attribute>"
    }
    flag "--implicit-filters" help="Control implicit time filters (default: true)" hide=#true {
        arg "<bool>"
    }
    flag "--benchmark" help="Run query benchmark" hide=#true
    flag "--concurrency" help="Benchmark concurrency level" hide=#true {
        arg "<n>"
    }
    flag "--samples" help="Number of benchmark samples" hide=#true {
        arg "<n>"
    }

    before_long_help #"""
        Allows you to perform queries on object metadata. You can perform
        either selection queries or aggregation queries, but not both at the
        same time.
        """#

    long_help #"""
        You may pass `--verbose` in order to get more detailed query performance
        data.

        The `--csv=<output file>` option may be passed in with a specified output
        file to output results to a CSV file instead. This may only be used with
        `--select` and/or `--select-wildcard` queries.

        **Filters:**

        The filter option expects a comma-delimited list of the form
        `<attribute>,<operation>,<value>`.

        The currently supported operations are `equal`, `regular-expression`,
        `inverse-regular-expression`, `at-least`, `greater-than`, `at-most`,
        `less-than`, `contains`, `not-contains`, `is-set`, and `is-not-set`.

        When using Coronerd 1.49 or greater, `contains`, `not-contains`,
        `regular-expression`, and `inverse-regular-expression` accept an optional 4th
        argument `case-insensitive` to enable case-insensitive filtering.

        **Pagination:**

        Pagination is handled with two flags

        `--limit=<n>` controls the number of returned rows. `--offset=<n>` controls the
        offset at which rows are returned, another way to put it is that it skips the
        first `<n>` rows.

        **Selection:**

        Selection can be done with two options, `--select=<attribute>` and
        `--select-wildcard=<physical|derived|virtual>`.

        `--select` allows to select particular attributes, while `--select-wildcard` selects
        all attributes that match the option.

        Wildcards can be one of:
        * `physical` - selects all attributes that are physically stored in objects,
        * `derived` - selects all derived attributes, such as `first_seen` or `original`,
        * `virtual` - selects all virtual (join) attributes.

        **Aggregations:**

        Aggregation is expressed through a myriad of command-line options that express
        different aggregation operations. Options are of form `--<option>=<attribute>`.

        The ``*`` factor is used when aggregations are performed when no factor is
        specified or if an object does not have a valid value associated with the
        factor.

        | Option           | Description |
        |------------------|-------------|
        | `--age`          | Specify a relative timestamp to now. `1h` ago, or `1d` ago. |
        | `--time`         | Specify a range using [Chrono](https://github.com/wanasit/chrono#readme). |
        | `--unique`       | provide a count of distinct values |
        | `--histogram`    | provide all distinct values |
        | `--distribution` | provide a truncated histogram |
        | `--mean`    	   | calculate the mean of a column |
        | `--sum`          | sum all values |
        | `--range`        | provide the minimum and maximum values |
        | `--count`        | count all non-null values |
        | `--bin`          | provide a linear histogram of values |
        | `--head`         | provide the first value in a factor |
        | `--tail`         | provide the last value in a factor |
        | `--object`       | provide the maximum object identifier of a column |

        **Sorting:**

        Sorting of results is done with the stackable option `--sort=<term>`. The term
        syntax is `[-](<column>|<fold_term>)`.

        - The optional `-` reverse the sort term order to descending, otherwise it
        defaults to ascending.
        - The `<column>` term refers to a valid column in the table. This is only
        effective for selection type query, i.e. when using the `--select` and/or `--select-wildcard` option.
        - The `<fold_term>` is an expression pointing to a fold operation. The
        expression language for fold operation is one of the following literal:
            - `;group`: sort by the group key itself.
            - `;count`: sort by the group count (number of crashes).
            - `column;idx`: where `column` is a string referencing a column in the fold
            dictionary and `idx` is an indice in the array. See examples .

        Multiple sort terms can be provided to break ties in case the previous
        referenced sort term has ties.

        #### Computed Views

        Coronerd offers support for a limited set of computed columns which can be
        used in selection and aggregation stages of a query.

        `--quantize-uint`:

        Forms:

        ```
        --quantize-uint output_column,input_column,size
        --quantize-uint output_column,input_column,size,offset
        ```

        Computes `( column + offset ) / size - offset` using integer math.  Used for
        data alignment and rounding.

        Size and offset may be integers or time units: `3600` and `1h` are both valid.

        Typically size is a bin size and offset is a timezone offset from UTC.

        For example, errors by day in EDT:

        ```
        morgue list project --count fingerprint --factor timestamp.edt.day --head timestamp.edt.day --quantize-uint timestamp.edt.day,timestamp,1d,-4h
        ```
    """#

    after_long_help #"""
        Examples:

        Request all faults from application deployments owned by jdoe.
        Provide the timestamp, hostname, callstack and classifiers.

        ```
        $ morgue list bidder --filter=tag_owner,equal,jdoe --select=timestamp --select=hostname --select=callstack --select=classifiers
        *
        #9d33    Thu Oct 13 2016 18:36:01 GMT-0400 (EDT)     5 months ago
        hostname: 2235.bm-bidderc.prod.nym2
        classifiers: abort stop
        callstack:
            assert ← int_set_union_all ← all_domain_lists ←
            setup_phase_unlocked ← bid_handler_slave_inner ← bid_handler_slave ←
            an_sched_process_task ← an_sched_slave ← event_base_loop ←
            an_sched_enter ← bidder_slave ← an_sched_pthread_cb
        #ef2f    Thu Oct 13 2016 18:36:01 GMT-0400 (EDT)     5 months ago
        hostname: 2066.bm-impbus.prod.nym2
        classifiers: abort stop
        callstack:
            assert ← an_discovery_get_instances ← budget_init_discovery ←
            main
        #119bf   Thu Oct 13 2016 18:36:01 GMT-0400 (EDT)     5 months ago
        hostname: 2066.bm-impbus.prod.nym2
        classifiers: abort stop
        callstack:
            assert ← an_discovery_get_instances ← budget_init_discovery ←
            main
        ```

        Request faults owned by jdoe, group them by fingerprint and aggregate
        the number of unique hosts, display a histogram of affected versions and
        provide a linear histogram of process age distribution.

        ```
        $ morgue list bidder --age=1y --factor=fingerprint --filter=tag_owner,equal,jdoe --head=callstack --unique=hostname --histogram=tag --bin=process.age
        823a55fb15bf697ba3041d736ade... ▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁ 5 months ago
        Date: Wed May 18 2016 18:44:35 GMT-0400 (EDT)
        callstack:
            assert ← int_set_union_all ← all_domain_lists ←
            setup_phase_unlocked ← bid_handler_slave_inner ← bid_handler_slave ←
            an_sched_process_task ← an_sched_slave ← event_base_loop ←
            an_sched_enter ← bidder_slave ← an_sched_pthread_cb
        histogram(tag):
        8.20.4.adc783.0 ▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆ 1
        unique(hostname): 1
        bin(process.age):
                7731         7732 ▆▆▆▆▆▆▆▆▆▆ 1

        3b851ac1ab1421409159cc38edb2... ▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁ 5 months ago
        Date: Tue May 17 2016 17:28:26 GMT-0400 (EDT)
            Tue May 17 2016 17:30:07 GMT-0400 (EDT)
        callstack:
            assert ← an_discovery_get_instances ← budget_init_discovery ←
            main
        histogram(tag):
        4.44.0.adc783.1 ▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆▆ 2
        unique(hostname): 1
        bin(process.age):
                    23           24 ▆▆▆▆▆▆▆▆▆▆ 1
                    24           25 ▆▆▆▆▆▆▆▆▆▆ 1
        ```

        Request faults for the last 2 years, group them by fingerprint, show the first
        object identifier in the group, sort the results by descending fingerprint,
        limit the results to 5 faults and skip the first 10 (according to sort order).

        ```
        $ morgue list blackhole --age=2y --factor=fingerprint --object=fingerprint --limit=5 --offset=10 --sort="-;group"
        fec4bfecf8e077cf44024f5668fa... ▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 2 years ago
        First Occurrence: Tue Jan 12 2016 13:30:12 GMT-0500 (EST)
            Occurrences: 360
        object(fingerprint): 1c653d

        fe7294a780a16e30b619e8d94a8a... █▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 2 years ago
        First Occurrence: Wed Oct 28 2015 11:30:47 GMT-0400 (EDT)
        Last Occurrence: Wed Oct 28 2015 12:16:19 GMT-0400 (EDT)
            Occurrences: 203
        object(fingerprint): 1c23b3

        fe5e0dda6cf0fb996a521dde4087... ▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 1 year ago
        First Occurrence: Tue Jun 14 2016 11:54:35 GMT-0400 (EDT)
            Occurrences: 1
        object(fingerprint): 2de5

        fe46d9af7c65c084091fed51ef02... █▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 2 years ago
        First Occurrence: Tue Oct 27 2015 16:59:34 GMT-0400 (EDT)
        Last Occurrence: Tue Oct 27 2015 20:05:30 GMT-0400 (EDT)
            Occurrences: 3
        object(fingerprint): 8f41

        fdc0860ef6dfd3d0397b53043ab9... ▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 1 year ago
        First Occurrence: Tue Jun 07 2016 11:51:55 GMT-0400 (EDT)
            Occurrences: 211
        object(fingerprint): 1c1958
        ```

        Request faults for the two years, group them by fingerprint, sum process.age,
        sort the results by descending sum of process.age per fingerprint, limit the
        results to 3 faults. Note here that `1` in `-process.age;1` is the second
        operator (`--sum`) in this case.

        ```
        $ morgue list blackhole --age=2y --factor=fingerprint --first=process.age --sum=process.age --limit=3 --sort="-process.age;1"
        d9358a6fdb7eaa143254b6987d00... ▁▁▁▁▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 1 year ago
        First Occurrence: Tue Sep 20 2016 21:59:46 GMT-0400 (EDT)
        Last Occurrence: Tue Sep 20 2016 22:03:23 GMT-0400 (EDT)
            Occurrences: 38586
        sum(process.age): 56892098354615 sec

        524b9f988c8ff9dfc1b3a0c71231... ▁▁▁▁▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 1 year ago
        First Occurrence: Tue Sep 20 2016 22:01:52 GMT-0400 (EDT)
        Last Occurrence: Tue Sep 20 2016 22:03:19 GMT-0400 (EDT)
            Occurrences: 25737
        sum(process.age): 37947233900547 sec

        bffd05c6b745229fd1c648bbe2a7... ▁▁▁▁▁▁▁▁▁▁▁▁▁▁█▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁ 1 year ago
        First Occurrence: Tue Sep 20 2016 21:59:46 GMT-0400 (EDT)
        Last Occurrence: Tue Sep 20 2016 22:03:01 GMT-0400 (EDT)
            Occurrences: 20096
        sum(process.age): 29630010305216 sec
        ```
        """#
}

cmd "delete" help="Delete objects by query or ID" {
    arg "<project>" help="Project name or universe/project"
    arg "[target]..." help="Query or object IDs" var=#true required=#false
    flag "--physical-only" help="Delete only physical data (default)"
    flag "--crdb-only" help="Delete only indexed data"
    flag "--all" help="Delete all related data"
    flag "--sync" help="Synchronous deletion" hide=#true
    flag "--chunklen" help="Batch size for deletions" hide=#true {
        arg "<n>"
    }
    flag "--first" help="First object ID in range" hide=#true {
        arg "<id>"
    }
    flag "--last" help="Last object ID in range" hide=#true {
        arg "<id>"
    }

    // Query filter flags (filter-only — no fold/aggregation flags since delete
    // uses buildQueryFilterOnly which does not process folds)
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<filter>"
    }
    flag "--limit" help="Number of rows to return" {
        arg "<n>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<n>"
    }
    flag "--select" help="Select specific attributes" var=#true {
        arg "<attribute>"
    }
    flag "--select-wildcard" help="Select all attributes of the given type" {
        arg "<type>" {
            choices physical derived virtual
        }
    }
    flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
        arg "<time>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<range>"
    }
    flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
        arg "<term>"
    }
    flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<spec>"
    }
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<query>"
    }
    flag "--table" help="Table to query against" hide=#true {
        arg "<query>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp" hide=#true {
        arg "<query>"
    }
    flag "--reverse" help="Reverse sort order" {
        arg "<attribute>"
    }
    flag "--template" help="Use a server-side named query template (e.g. select)" {
        arg "<attribute>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<attribute>"
    }
    flag "--fingerprint" help="Filter by fingerprint: exact match (64 chars) or prefix regex" {
        arg "<value>"
    }

    long_help #"""
        An optional subset can be specified to indicate whether physical, indexed, or
        both are deleted. By default, this command (as of 2019-02-26) requests
        physical-only deletion, which retains only indexing.  The previous
        `--physical-only` argument is now a no-op.

        The following options affect this behavior:
        * `--physical-only` (default): Deletes only the physical data.
        * `--crdb-only`: Delete only the indexed data; requires physically deleted objects.
        * `--all`: Delete all related data, including indexing.

        Either a query or a list of object identifiers must be passed.

        Queries follow the same format as the `morgue list` command.

        Object IDs can be obtained by using the `morgue list` output. The object ID
        printed in the previous example is `9d33`.
        """#

    after_long_help #"""
        Example:

        Delete all data, physical and indexed, in the blackhole project
        after 2023-11-14 22:13:20 UTC:

        ```
        $ morgue delete blackhole --all --filter="timestamp,greater-than,1700000000"
        ```

        Example:

        Delete physical data (default subset) for object with identifier 9d33.

        ```
        $ morgue delete blackhole 9d33
        ```
        """#
}

cmd "project" subcommand_required=#true help="Create projects" {
    cmd "create" help="Create new project" {
        arg "<name>" help="Project name"
    }
}

cmd "projects" subcommand_required=#true help="List projects" {
    cmd "list" help="List all projects"
}

cmd "flamegraph" help="Generate callstack flamegraph" {
    arg "<project>" help="Project name or universe/project"

    flag "-o --output" help="Output SVG file" {
        arg "<file>"
    }
    flag "--unique" help="Sample only unique crashes"
    flag "--reverse" help="Sample from leaf functions"
    
    // argvQuery
    // Filters
    flag "--filter" help="Filter expression: attribute,operation,value" {
        arg "<filter>"
    }
    // Pagination
    flag "--limit" help="Number of rows to return" {
        arg "<n>"
    }
    flag "--offset" help="Skip first N rows" {
        arg "<n>"
    }
    // Selection
    flag "--select" help="Select specific attributes" var=#true {
        arg "<attribute>"
    }
    flag "--select-wildcard" help="Select all attributes of the given type" {
        arg "<type>" {
            choices physical derived virtual
        }
    }
    // argvQuery (filter/time flags only — fold flags not applicable here)
    flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
        arg "<time>"
    }
    flag "--time" help="Time range using natural language" {
        arg "<range>"
    }
    // Sorting
    flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
        arg "<term>"
    }
    // Computed Views
    flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
        arg "<spec>"
    }
    // Not documented
    flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
        arg "<query>"
    }
    flag "--table" help="Table to query against" hide=#true {
        arg "<query>"
    }
    flag "--timestamp-attribute" help="Attribute to use as timestamp" hide=#true {
        arg "<query>"
    }
    flag "--template" help="Use a server-side named query template (e.g. select)" {
        arg "<attribute>"
    }
    flag "--factor" help="Group by attribute" {
        arg "<attribute>"
    }
    flag "--fingerprint" help="Filter by fingerprint: exact match (64 chars) or prefix regex" {
        arg "<value>"
    }

    long_help #"""
        Generate a flamegraph of callstacks of all objects matching the specified
        filter criteria. The `--filter` option behaves identically to the `morgue list`
        command. This functionality requires `perl` to be installed.
        To learn more about flamegraphs, please see
        http://www.brendangregg.com/flamegraphs.html.

        Use `--unique` to only sample unique crashes. Use `--reverse` to begin sampling
        from leaf functions.
        """#
}

cmd "symbold" subcommand_required=#true help="Manage Backtrace symbold service" {
    cmd "status" help="Get symbold service status" {
        arg "<project>" help="Project name"
    }

    cmd "symbolserver" subcommand_required=#true help="Manage symbol servers" {
        cmd "list" help="List symbol servers" {
            arg "<project>" help="Project name"
            flag "--page" help="Page number" {
                arg "<n>"
            }
            flag "--take" help="Items per page" {
                arg "<n>"
            }
            after_long_help #"""
                Example:

                ```
                $ morgue symbold symbolserver list backtrace
                ```
                """#
        }

        cmd "details" help="Get symbol server details" {
            arg "<id>" help="Symbol server ID"

            after_long_help #"""
                Example:

                ```
                $ morgue symbold symbolserver details 1
                ```
                """#
        }

        cmd "logs" help="Get symbol server logs" {
            arg "<id>" help="Symbol server ID"

            cmd "filter" {
                arg "<filter>" help="Filter string"

                flag "--take" help="Number of logs" {
                    arg "<n>"
                }
                flag "--page" help="Page number" {
                    arg "<n>"
                }

                after_long_help #"""
                    Example:

                    ```
                    morgue.js symbold symbolserver logs 5 filter a --take=100 --page=1
                    ```
                    """#
            }

            flag "--take" help="Number of logs" {
                arg "<n>"
            }
            flag "--page" help="Page number" {
                arg "<n>"
            }

            after_long_help #"""
                Example:

                ```
                $ morgue symbold symbolserver logs 1 --take=100 --page=0
                ```

                Command above will return first 100 logs from page 0
                """#
        }

        cmd "add" help="Add symbol server" {
            arg "<project>" help="Project name"
            arg "<url>" help="Symbol server URL"

            flag "--name" help="Server name" required=#true {
                arg "<name>"
            }
            flag "--concurrentdownload" help="Max concurrent downloads" {
                arg "<n>"
            }
            flag "--retrylimit" help="Retry limit" {
                arg "<n>"
            }
            flag "--timeout" help="Download timeout" {
                arg "<ms>"
            }
            flag "--whitelist" help="Use whitelist" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--retain" help="Retain original symbols" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--servercredentials.username" help="Symbol server auth user name" {
                arg "<username>"
            }
            flag "--servercredentials.password" help="Symbol server auth password" {
                arg "<password>"
            }
            flag "--aws.accesskey" help="AWS S3 access key" {
                arg "<access_key>"
            }
            flag "--aws.secret" help="AWS S3 secret" {
                arg "<secret_key>"
            }
            flag "--aws.bucketname" help="AWS S3 bucket name" {
                arg "<bucket_name>"
            }
            flag "--aws.lowerfile" help="Determine if symbold should use lower case symbol name" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--aws.lowerid" help="Determine if symbold should use lower case debug id" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--aws.usepdb" help="Determine a way to generate url to S3 symbols" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--proxy.host" help="Proxy host" {
                arg "<proxy_host>"
            }
            flag "--proxy.port" help="Proxy port" {
                arg "<proxy_port>"
            }
            flag "--proxy.username" help="Proxy username" {
                arg "<proxy_username>"
            }
            flag "--proxy.password" help="Proxy password" {
                arg "<proxy_password>"
            }
            flag "--force" help="Force creation" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--retrytimeout" help="Download retry timeout" {
                arg "<ms>"
            }

            after_long_help #"""
                Example:

                ```
                $ morgue symbold symbolserver add backtrace https://symbol.server.com --name=name --timeout=400
                ```
                """#
        }

        cmd "update" help="Update symbol server" {
            arg "<id>" help="Symbol server ID"

            flag "--name" help="Server name" {
                arg "<name>"
            }
            flag "--symbolServerUrl" help="Symbol server URL" {
                arg "<url>"
            }
            flag "--concurrentdownload" help="Max concurrent downloads" {
                arg "<n>"
            }
            flag "--retrylimit" help="Retry limit" {
                arg "<n>"
            }
            flag "--timeout" help="Download timeout" {
                arg "<ms>"
            }
            flag "--retrytimeout" help="Download retry timeout" {
                arg "<ms>"
            }
            flag "--whitelist" help="Use whitelist" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--retain" help="Retain original symbols" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--servercredentials.username" help="Symbol server auth user name" {
                arg "<username>"
            }
            flag "--servercredentials.password" help="Symbol server auth password" {
                arg "<password>"
            }
            flag "--aws.accesskey" help="AWS S3 access key" {
                arg "<access_key>"
            }
            flag "--aws.secret" help="AWS S3 secret" {
                arg "<secret_key>"
            }
            flag "--aws.bucketname" help="AWS S3 bucket name" {
                arg "<bucket_name>"
            }
            flag "--aws.lowerfile" help="Determine if symbold should use lower case symbol name" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--aws.lowerid" help="Determine if symbold should use lower case debug id" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--aws.usepdb" help="Determine a way to generate url to S3 symbols" {
                arg "<bool>" {
                    choices "true" "false"
                }
            }
            flag "--proxy.host" help="Proxy host" {
                arg "<proxy_host>"
            }
            flag "--proxy.port" help="Proxy port" {
                arg "<proxy_port>"
            }
            flag "--proxy.username" help="Proxy username" {
                arg "<proxy_username>"
            }
            flag "--proxy.password" help="Proxy password" {
                arg "<proxy_password>"
            }

            after_long_help #"""
                ```
                Update symbol server with ID. If aws, proxy and servercredentials data doesn't exists symbold will ignore update server credentials.
                If any of them exists, symbold will try to update all properties.

                Example:

                ```
                $ morgue symbold symbolserver update 1 --url="http://new.symbol.server.url"
                ```
                """#
        }

        cmd "delete" help="Delete symbol server" {
            arg "<id>" help="Symbol server ID"
        }

        cmd "disable" help="Disable symbol server" {
            arg "<id>" help="Symbol server ID"
        }

        cmd "enable" help="Enable symbol server" {
            arg "<id>" help="Symbol server ID"
        }
    }

    cmd "whitelist" subcommand_required=#true help="Manage whitelist" {
        cmd "add" help="Add to whitelist" {
            arg "<server_id>" help="Symbol server ID"
            flag "--name" help="Item name" {
                arg "<name>"
            }
        }

        cmd "remove" help="Remove from whitelist" {
            arg "<id>" help="Item ID" required=#true
        }

        cmd "list" help="List whitelist items" {
            arg "<server_id>" help="Symbol server ID"
            flag "--page" help="Page number" {
                arg "<n>"
            }
            flag "--take" help="Items per page" {
                arg "<n>"
            }
        }
    }

    cmd "blacklist" subcommand_required=#true help="Manage blacklist" {
        cmd "add" help="Add to blacklist" {
            arg "<server_id>" help="Symbol server ID"
            flag "--name" help="Item name" {
                arg "<name>"
            }
        }

        cmd "remove" help="Remove from blacklist" {
            arg "<id>" help="Item ID" required=#true
        }

        cmd "list" help="List blacklist items" {
            arg "<server_id>" help="Symbol server ID"
            flag "--page" help="Page number" {
                arg "<n>"
            }
            flag "--take" help="Items per page" {
                arg "<n>"
            }
        }
    }

    cmd "skiplist" subcommand_required=#true help="Manage skiplist" {
        cmd "find" help="Find items in skiplist" {
            arg "<server_id>" help="Symbol server ID"
            arg "<filter>" help="Filter string"

            flag "--page" help="Page number" {
                arg "<n>"
            }
            flag "--take" help="Items per page" {
                arg "<n>"
            }
        }

        cmd "remove" help="Remove from skiplist" {
            arg "[id]" help="Item ID" required=#false

            cmd "all" help="Remove all items" {
                arg "<server_id>" help="Symbol server ID"
            }

            cmd "filter" help="Remove by filter" {
                arg "<server_id>" help="Symbol server ID"
                arg "<filter>" help="Filter criteria"
            }
        }
    }

    cmd "queue" subcommand_required=#true help="Manage symbold queue" {
        cmd "list" help="List queue events"

        cmd "add" help="Add to queue" {
            // alias "create"
            arg "<project>" help="Universe/project"
            arg "<symbol>" help="Missing symbol"
            arg "<oid>" help="Object ID"
        }

        cmd "size" help="Get queue size"

        cmd "symbols" help="List missing symbols from events"
    }
}

cmd "report" subcommand_required=#true help="Manage scheduled reports" {
    arg "<project>" help="Project name"

    cmd "list" help="List reports"

    cmd "create" help="Create report" {
        flag "--rcpt" help="Recipient email" required=#true var=#true {
            arg "<email>"
        }
        flag "--title" help="Report title" required=#true {
            arg "<title>"
        }
        flag "--period" help="Period: week|day (default: week)" {
            arg "<period>" {
                choices week day
            }
        }
        // Undocumented create flags
        // See coronerReport, in: if (action === 'create') { ... }
        flag "--timezone" help="Timezone for report" hide=#true {
            arg "<timezone>"
        }
        flag "--day" help="Day of week (1=Monday)" hide=#true {
            arg "<n>"
        }
        flag "--hour" help="Hour of day to send (default: 9)" hide=#true {
            arg "<n>"
        }
        flag "--include-users" help="Whether to include users in the report" hide=#true

        // Query flags (keep in sync with list command!) argvQuery
        // Filters
        flag "--filter" help="Filter expression: attribute,operation,value" {
            arg "<filter>"
        }
        // Pagination
        flag "--limit" help="Number of rows to return" {
            arg "<n>"
        }
        flag "--offset" help="Skip first N rows" {
            arg "<n>"
        }
        // Selection
        flag "--select" help="Select specific attributes" var=#true {
            arg "<attribute>"
        }
        flag "--select-wildcard" help="Select all attributes of the given type" {
            arg "<type>" {
                choices physical derived virtual
            }
        }
        // Aggregations
        flag "--age" help="Relative timestamp (e.g., 1h, 42d, 10s, etc). Valid suffixes: y (years), M (months), w (weeks), d (days), h (hours), m (minutes), s (seconds)" {
            arg "<time>"
        }
        flag "--time" help="Time range using natural language" {
            arg "<range>"
        }
        flag "--unique" help="Count distinct values" {
            arg "<attribute>"
        }
        flag "--histogram" help="Show all distinct values" {
            arg "<attribute>"
        }
        flag "--distribution" help="Show truncated histogram" {
            arg "<attribute>"
        }
        flag "--mean" help="Calculate mean" {
            arg "<attribute>"
        }
        flag "--sum" help="Sum all values" {
            arg "<attribute>"
        }
        flag "--range" help="Show min and max values" {
            arg "<attribute>"
        }
        flag "--count" help="Count non-null values" {
            arg "<attribute>"
        }
        flag "--bin" help="Linear histogram of values" {
            // alias "quantize"
            arg "<attribute>"
        }
        flag "--head" help="First value in factor" {
            arg "<attribute>"
        }
        flag "--tail" help="Last value in factor" {
            arg "<attribute>"
        }
        flag "--object" help="Maximum object identifier" {
            arg "<attribute>"
        }
        // Aggregations (undocumented)
        flag "--last" help="Last object identifier" hide=#true {
            arg "<attribute>"
        }
        flag "--first" help="First object identifier" hide=#true {
            arg "<attribute>"
        }
        flag "--min" help="Min object identifier" hide=#true {
            arg "<attribute>"
        }
        flag "--max" help="Max object identifier" hide=#true {
            arg "<attribute>"
        }
        // Sorting
        flag "--sort" var=#true help="Sort results: [-](column|fold_term)" {
            arg "<term>"
        }
        // Computed Views
        flag "--quantize-uint" var=#true help="Compute quantized column: output_column,input_column,size[,offset]" {
            arg "<spec>"
        }
        // Not documented
        flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
            arg "<query>"
        }
        flag "--table" help="Table to query against" hide=#true {
            arg "<query>"
