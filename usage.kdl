cmd "access" subcommand_required=#true help="Control access permissions" {
    cmd "team" subcommand_required=#true help="Manage teams" {
        cmd "create" help="Create team" {
            arg "<TEAM>" help="Team name"
        }

        cmd "remove" help="Remove team" {
            arg "<TEAM>" help="Team name"
        }

        cmd "details" help="Get team details" {
            arg "<TEAM>" help="Team name"
        }

        cmd "add-user" help="Add user to team" {
            arg "<TEAM>" help="Team name"
            arg "<USER>" help="Username"
        }

        cmd "remove-user" help="Remove user from team" {
            arg "<TEAM>" help="Team name"
            arg "<USER>" help="Username"
        }

        cmd "list" help="List all teams"
    }

    cmd "project" subcommand_required=#true help="Manage project access" {
        arg "<PROJECT>" help="Project name"

        cmd "add-team" help="Add team to project" {
            arg "<TEAM>" help="Team name"
            arg "<ROLE>" help="Role: admin|member|guest"
        }

        cmd "remove-team" help="Remove team from project" {
            arg "<TEAM>" help="Team name"
        }

        cmd "add-user" help="Add user to project" {
            arg "<USER>" help="Username"
            arg "<ROLE>" help="Role: admin|member|guest"
        }

        cmd "remove-user" help="Remove user from project" {
            arg "<USER>" help="Username"
        }

        cmd "details" help="Get project access details"
    }
}

