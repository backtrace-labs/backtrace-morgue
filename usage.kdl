cmd "attribute" subcommand_required=#true help="Manage project attributes" {
    cmd "create" help="Create attribute" {
        arg "<PROJECT>" help="Project name"
        arg "<NAME>" help="Attribute name"
        
        flag "--description" help="Attribute description" {
            arg "<DESC>"
        }
        flag "--type" help="Type: bitmap|uint8|uint16|uint32|uint64|uint128|uuid|dictionary" {
            arg "<TYPE>" {
                choices bitmap uint8 uint16 uint32 uint64 uint128 uuid dictionary
            }
        }
        flag "--format" help="Format: none|commit|semver|callstack|hostname|bytes|kilobytes|gigabytes|nanoseconds|milliseconds|seconds|unix_timestamp|js_timestamp|gps_timestamp|memory_address|labels|sha256|uuid|ipv4|ipv6" {
            arg "<FORMAT>" {
                choices none commit semver callstack hostname bytes kilobytes gigabytes nanoseconds milliseconds seconds unix_timestamp js_timestamp gps_timestamp memory_address labels sha256 uuid ipv4 ipv6
            }
        }
    }
    
    cmd "delete" help="Delete attribute" {
        arg "<PROJECT>" help="Project name"
        arg "<NAME>" help="Attribute name"
