cmd "alerts" subcommand_required=#true help="Manage alerts" {
    cmd "target" subcommand_required=#true help="Manage alert targets" {
        cmd "create" help="Create target" {
            flag "--project" help="Project name" required=#true {
                arg "<PROJECT>"
            }
            flag "--name" help="Target name" required=#true {
                arg "<NAME>"
            }
            flag "--workflow-name" help="Workflow name" required=#true {
                arg "<NAME>"
            }
        }
        
        cmd "list" help="List targets"
        
        cmd "get" help="Get target" {
            flag "--id" help="Target ID" {
                arg "<ID>"
            }
            flag "--name" help="Target name" {
                arg "<NAME>"
            }
        }
        
        cmd "update" help="Update target" {
            flag "--id" help="Target ID" {
                arg "<ID>"
            }
            flag "--name" help="Target name" {
                arg "<NAME>"
            }
            flag "--rename" help="New name" {
                arg "<NAME>"
            }
            flag "--workflow-name" help="New workflow" {
                arg "<NAME>"
            }
        }
        
        cmd "delete" help="Delete target" {
            flag "--id" help="Target ID" {
                arg "<ID>"
            }
            flag "--name" help="Target name" {
                arg "<NAME>"
            }
        }
    }
    
    cmd "alert" subcommand_required=#true help="Manage alerts" {
        cmd "list" help="List alerts"
        
        cmd "get" help="Get alert" {
            flag "--id" help="Alert ID" {
                arg "<ID>"
            }
            flag "--name" help="Alert name" {
                arg "<NAME>"
            }
        }
        
        cmd "update" help="Update alert" {
            flag "--id" help="Alert ID" {
                arg "<ID>"
            }
            flag "--name" help="Alert name" {
                arg "<NAME>"
            }
            flag "--rename" help="New name" {
                arg "<NAME>"
            }
            flag "--replace-query" help="Replace query"
            flag "--clear-targets" help="Clear targets"
            // Other update flags
        }
        
        cmd "delete" help="Delete alert" {
            flag "--id" help="Alert ID" {
                arg "<ID>"
            }
            flag "--name" help="Alert name" {
                arg "<NAME>"
            }
        }

        cmd "create" help="Create alert" {
            flag "--universe" help="Universe name" required=#false {
                arg "<UNIVERSE>"
            }
            flag "--project" help="Project name" required=#false {
                arg "<PROJECT>"
            }
            flag "--name" help="Alert name" required=#true {
                arg "<NAME>"
            }
            flag "--enabled" help="Enable alert" {
                arg "<BOOL>"
            }
            flag "--query-period" help="Query period" required=#true {
                arg "<TIME>"
            }
            flag "--min-notification-interval" help="Min notification interval" required=#true {
                arg "<TIME>"
            }
            flag "--mute-until" help="Mute until timestamp" {
                arg "<TS>"
            }
            flag "--target-name" help="Target name" required=#false var=#true {
                arg "<NAME>"
            }
            flag "--target-id" help="Target ID" required=#false var=#true {
                arg "<ID>"
            }
            flag "--trigger" help="Trigger spec: column,index,op,warn,crit" required=#true {
                arg "<SPEC>"
            }
            // Query flags (keep in sync with list command!)
            // Filters
            flag "--filter" help="Filter expression: attribute,operation,value" {
                arg "<FILTER>"
            }
            // Pagination
            flag "--limit" help="Number of rows to return" {
                arg "<N>"
            }
            flag "--offset" help="Skip first N rows" {
                arg "<N>"
            }
            // Selection
            flag "--select" help="Select specific attributes" var=#true {
                arg "<ATTRIBUTE>"
            }
            flag "--select-wildcard" help="Select all attributes of type: physical|derived|virtual" {
                arg "<TYPE>" {
                    choices physical derived virtual
                }
            }
            // Aggregations
            flag "--age" help="Relative timestamp (e.g., 1h, 1d)" {
                arg "<TIME>"
            }
            flag "--time" help="Time range using natural language" {
                arg "<RANGE>"
            }
            flag "--unique" help="Count distinct values" {
                arg "<ATTRIBUTE>"
            }
            flag "--histogram" help="Show all distinct values" {
                arg "<ATTRIBUTE>"
            }
            flag "--distribution" help="Show truncated histogram" {
                arg "<ATTRIBUTE>"
            }
            flag "--mean" help="Calculate mean" {
                arg "<ATTRIBUTE>"
            }
            flag "--sum" help="Sum all values" {
                arg "<ATTRIBUTE>"
            }
            flag "--range" help="Show min and max values" {
                arg "<ATTRIBUTE>"
            }
            flag "--count" help="Count non-null values" {
                arg "<ATTRIBUTE>"
            }
            flag "--bin" help="Linear histogram of values" aliases="quantize" {
                arg "<ATTRIBUTE>"
            }
            flag "--head" help="First value in factor" {
                arg "<ATTRIBUTE>"
            }
            flag "--tail" help="Last value in factor" {
                arg "<ATTRIBUTE>"
            }
            flag "--object" help="Maximum object identifier" {
                arg "<ATTRIBUTE>"
            }
            // Aggregations (undocumented)
            flag "--last" help="Last object identifier" hide=#true {
                arg "<ATTRIBUTE>"
            }
            flag "--first" help="First object identifier" hide=#true {
                arg "<ATTRIBUTE>"
            }
            flag "--min" help="Min object identifier" hide=#true {
                arg "<ATTRIBUTE>"
            }
            flag "--max" help="Max object identifier" hide=#true {
                arg "<ATTRIBUTE>"
            }
            // Sorting
            flag "--sort" help="Sort results: [-](column|fold_term)" {
                arg "<TERM>"
            }
            // Computed Views
            flag "--quantize-uint" help="Compute quantized column: output_column,input_column,size[,offset]" {
                arg "<SPEC>"
            }
            // Not documented
            flag "--raw-query" help="Raw query to use (overrides all other flags)" hide=#true {
                arg "<QUERY>"
            }
            flag "--table" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
                arg "<QUERY>"
            }
            flag "--timestamp-attribute" help="Attribute to use as timestamp (defaults to 'timestamp', unless table is )" hide=#true {
                arg "<QUERY>"
            }
            flag "--reverse" help="Reverse sort order" {
                arg "<ATTRIBUTE>"
            }
            flag "--template" help="TODO: (ex: select)" { // TODO
                arg "<ATTRIBUTE>"
            }
            flag "--factor" help="Group by attribute" {
                arg "<ATTRIBUTE>"
            }
            flag "--fingerprint" help="Filter by an exact fingerprint, or a regex anchored to the beginning of the fingerprint" { // TODO: better help/example
                arg "<VALUE>"
            }
        }
    }
}

